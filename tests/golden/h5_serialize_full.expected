#pragma once

#include <h5cpp/all>
namespace h5 {
    template<> hid_t inline register_struct<sn::sensor::serialize_full_t>(){

        hid_t ct_00 = H5Tcreate(H5T_COMPOUND, sizeof (sn::sensor::serialize_full_t));
        H5Tinsert(ct_00, "timestamp_ns",	HOFFSET(sn::sensor::serialize_full_t,timestamp_ns),H5T_NATIVE_ULLONG);

        return ct_00;
    };
}
H5CPP_REGISTER_STRUCT(sn::sensor::serialize_full_t);


