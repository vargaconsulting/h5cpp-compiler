#pragma once

/* Generated by h5cpp-compiler BSON backend */

#include <cstddef>
#include <cstdint>

namespace bson::meta {

enum class bson_type_t : std::uint8_t {
    null, undefined, boolean,
    int32, int64, double, decimal128,
    string, binary,
    document, array,
    object_id, utc_datetime, timestamp,
    regex, db_pointer, js_code, symbol,
    min_key, max_key,
    optional
};

struct field_desc {
    const char*   json_name;
    bson_type_t   type;
    std::uint8_t  binary_subtype;
    std::size_t   offset;
    bool          required;
    const char*   doc;
    const field_desc* item;
    const field_desc* key;
    const field_desc* value;
};

template<typename T>
struct descriptor {
    static constexpr char alias[] = "";
    static constexpr field_desc fields[] = {};
    static constexpr std::size_t field_count = 0;
};

} // namespace bson::meta

// descriptor for sn::typecheck::Inner
template<>
